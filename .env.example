# ---- Harvester ----
CHROME_PATH="C:/Program Files (x86)/Google/Chrome/Application/chrome.exe"
CHROME_PROFILE_DIR=./chrome-profile
CHROME_DEBUG_PORT=9555
HEADLESS=false
MAX_REELS=150
MAX_MINUTES=25

# ---- LLM (song guessing + genre classification) ----
# auto = use local Ollama/LM Studio if running, else Claude if a key is set. Or force: ollama | openai | claude
LLM_PROVIDER=auto
# ollama tag, or the model name LM Studio shows
LLM_MODEL=gemma-4-12b:latest
# `mastgaane library` labels thousands of songs (language, genre, mood, year): keep the 12B model here
LIBRARY_LLM_MODEL=gemma-4-12b:latest
# blank = ollama http://127.0.0.1:11434 ; LM Studio = http://127.0.0.1:1234/v1
LLM_BASE_URL=
# if the chosen provider fails, try the others
LLM_FALLBACK=true
# start `ollama serve` automatically if installed
LLM_AUTOSTART=true
# optional: Claude (better Hindi/Urdu song knowledge)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ---- Resolver ----
# optional fallback fingerprinting
AUDD_API_KEY=
# tiny|base|small|medium
WHISPER_MODEL=small
AUTO_APPROVE_MIN_CONFIDENCE=0.8

# ---- Playlists ----
PLAYLIST_NAME=MastGaane - Late Night
YTMUSIC_ENABLED=true
YTMUSIC_AUTH_FILE=./browser.json
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8788/callback
APPLE_ENABLED=true
# optional MusicKit developer token (needs Apple Developer Program); leave blank to use the iPhone Shortcut route
APPLE_DEV_TOKEN=

# ---- Listen (Shazam inside MastGaane) ----
# part of the microphone's name, or several in order of preference (yeti,brio: the Blue Yeti, else the
# Brio 100); blank = every real mic records and the loudest wins
LISTEN_MIC=yeti,brio
LISTEN_SECONDS=10

# ---- Tray ----
# `mastgaane serve` shows an icon in the Windows tray (pause / next / stop the music, quit)
TRAY=true

# ---- Misc ----
LATE_NIGHT_START=23
LATE_NIGHT_END=4
TIMEZONE=Asia/Kolkata

# ---- FM host voice ----
# Gemini TTS gives the host an emotional, designed young Indian woman's voice (free key:
# https://aistudio.google.com/apikey). Without a key, or when its quota runs out, edge-tts speaks.
GEMINI_API_KEY=
# auto | gemini | edge
JOCKEY_TTS=auto
# free tier: 10 links a day per model; when one has used its day the next speaks
GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# a native Hindi voice (GET /v1beta/voices?language_code=hi-IN), e.g. hi-in-podcaster-9, a 25-year-old
# radio host from Delhi; blank = one designed for MastGaane on first use (data/gemini_voice.json)
GEMINI_TTS_VOICE=hi-in-podcaster-9
# the edge-tts voice: hi-IN-SwaraNeural, hi-IN-MadhurNeural (male), mr-IN-AarohiNeural
JOCKEY_VOICE=hi-IN-SwaraNeural
# the host talks before every Nth song; once Gemini's free day is spent: quiet | edge (JOCKEY_VOICE speaks)
JOCKEY_TALK_EVERY=2
JOCKEY_FALLBACK=quiet
# the first thing played each morning (a YouTube Music search; "" = none)
MORNING_OPENER=Hanuman Chalisa Hariharan

# ---- Voice commands: "Bharti, agla gaana" ----
# Dexter hears them and hands them over. true = MastGaane listens on its own mic as well (weaker: a small
# CPU model, which takes singers for "Bharti"; for when Dexter is not running)
VOICE_CONTROL=false
VOICE_WAKE_WORDS=bharti,radio,fm
# part of a mic's name; blank = LISTEN_MIC, else the loudest real mic
VOICE_MIC=
VOICE_WHISPER_MODEL=small
VOICE_SCREEN_MODEL=base
VOICE_CHIME=true

# MastGaane FM as a radio that is simply on: start playing as soon as `serve` is up (the hour's
# programme or mix; Hanuman Chalisa first thing in the morning). Default false: a logon start
# stays quiet until you, Dexter or "Bharti, gaana chalao" ask.
# AUTOPLAY=false

# After the morning opener, this many bhajans start a morning (5-12) session before the usual mix. 0 = off.
# MORNING_BHAJANS=3
